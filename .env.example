# Copy this file to .env and fill in your Supabase project values
# (Project Settings -> API in the Supabase dashboard).
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional Discord Embedded App (Activity) configuration.
# The client ID is public; the secret must only be read by server/game-server.ts.
VITE_DISCORD_CLIENT_ID=your-discord-application-client-id
DISCORD_CLIENT_SECRET=your-discord-application-client-secret
DISCORD_ACTIVITY_SESSION_SECRET=replace-with-a-random-32-byte-secret
# Set to true only for the Discord-only deployment; omit for dual web/Discord hosting.
DISCORD_ACTIVITY_ONLY=false
